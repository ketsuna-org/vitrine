      "button": {
        "label": "string?",
        "style": "primary|secondary|success|danger|link|premium?",
        "customId": "string?",
        "url": "string?",
        "emoji": "string?",
        "disabled": "string?",
        "skuId": "string?",
        "graph": "Graph?"
      },
      "stringSelect": {
        "customId": "string?",
