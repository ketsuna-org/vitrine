{
  "Graph": {
    "desc": "Graphe d'une commande, d'un workflow ou d'un gestionnaire en ligne (format v2) : { version: 2, nodes, links, data }. Le départ est le pseudo-nœud réservé `start` (pin `next`), absent de `nodes`. Un nœud = une action ; les liens de flux relient un pin de sortie à un nœud ; plusieurs liens sur un pin = branches parallèles lancées dans l'ordre des liens.",
    "fields": {
      "version": "number",
      "nodes": "GraphNode[]",
      "links": "GraphLink[]",
      "data": "GraphDataLink[]?"
    }
  },
  "GraphNode": {
    "desc": "Un nœud : { id, type, key, enabled?, payload?, error?, src?, pos? }. `id` (n1, n2…) est interne et stable : les liens s'y réfèrent. `key` est la clé de résultat, REQUISE et non vide (le résultat se lit ((action.<key>)) ; non unique, le dernier écrivain gagne ; l'éditeur donne action_<n>). error.mode = stop (défaut) ou continue. src = { line, col, fn } : origine du nœud dans le script BDFD converti, posée par la conversion, conservée telle quelle (ne pas l'écrire à la main). Le payload ne contient AUCUNE sous-liste d'actions.",
    "fields": {
      "id": "string",
      "type": "string",
      "key": "string",
      "enabled": "boolean?",
      "payload": "object?",
      "error": "object?",
      "src": "object?",
      "pos": "object?"
    }
  },
  "GraphLink": {
    "desc": "Lien de flux : { from: { node, pin }, to }. node = id d'un nœud ou `start` ; pins : next, then, elseif:<i>, else, body, try, catch, done, error, case:<valeur>, default (voir le nœud). `to` = id du nœud cible.",
    "fields": {
      "from": "object",
      "to": "string"
    }
  },
  "GraphDataLink": {
    "desc": "Lien de données optionnel : { from: { node, out }, to: { node, field }, type } avec type any|text|number|list|object|boolean. Le chaînage principal reste ((action.<key>)).",
    "fields": {
      "from": "object",
      "to": "object",
      "type": "string?"
    }
  },
  "Embed": {
    "desc": "Embed Discord. Les valeurs acceptent les placeholders ((...)). color: hex #RRGGBB.",
    "fields": {
      "title": "string?",
      "url": "string?",
      "description": "string?",
      "color": "string?",
      "author": "EmbedAuthor?",
      "footer": "EmbedFooter?",
      "thumbnail": "EmbedMedia?",
      "image": "EmbedMedia?",
      "timestamp": "string?",
      "fields": "EmbedField[]?"
    }
  },
  "EmbedAuthor": {
    "fields": {
      "name": "string",
      "icon_url": "string?",
      "url": "string?"
    }
  },
  "EmbedFooter": {
    "fields": {
      "text": "string",
      "icon_url": "string?"
    }
  },
  "EmbedMedia": {
    "fields": {
      "url": "string"
    }
  },
  "EmbedField": {
    "fields": {
      "name": "string",
      "value": "string",
      "inline": "boolean?"
    }
  },
  "Condition": {
    "desc": "Condition feuille OU groupe. Feuille: variable+operator+value. Groupe: group (and|or) + conditions[] + negate optionnel.",
    "oneOf": [
      "ConditionLeaf",
      "ConditionGroup"
    ]
  },
  "ConditionLeaf": {
    "fields": {
      "variable": "string",
      "operator": "equals|notEquals|equalsIgnoreCase|contains|containsIgnoreCase|notContains|containsItem|startsWith|endsWith|greaterThan|lessThan|greaterOrEqual|lessOrEqual|isEmpty|isNotEmpty|matches|hasPermission?",
      "value": "string|number?"
    }
  },
  "ConditionGroup": {
    "fields": {
      "group": "and|or",
      "conditions": "Condition[]",
      "negate": "boolean?"
    }
  },
  "ComponentsDef": {
    "desc": "Valeur du param components pour message/composants V2: { components: Component[] }.",
    "fields": {
      "components": "Component[]"
    }
  },
  "Component": {
    "desc": "Nœud de composant, discriminé par type. Les boutons et menus peuvent porter un sous-graphe en ligne (`graph`, de type Graph) exécuté au clic.",
    "discriminator": "type",
    "variants": {
      "actionRow": {
        "components": "Component[]"
