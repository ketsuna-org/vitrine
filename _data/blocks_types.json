        "options": "SelectOption[]",
        "minValues": "number?",
        "maxValues": "number?",
        "disabled": "string?",
        "graph": "Graph?"
      },
      "userSelect": {
        "customId": "string?",
        "placeholder": "string?",
        "minValues": "number?",
        "maxValues": "number?",
        "disabled": "string?",
        "graph": "Graph?"
      },
      "roleSelect": {
        "customId": "string?",
        "placeholder": "string?",
        "minValues": "number?",
        "maxValues": "number?",
        "disabled": "string?",
        "graph": "Graph?"
      },
      "mentionableSelect": {
        "customId": "string?",
        "placeholder": "string?",
        "minValues": "number?",
        "maxValues": "number?",
        "disabled": "string?",
        "graph": "Graph?"
      },
      "channelSelect": {
        "customId": "string?",
        "placeholder": "string?",
        "minValues": "number?",
        "maxValues": "number?",
        "disabled": "string?",
        "graph": "Graph?"
      },
      "textInput": {
        "customId": "string?",
        "label": "string?",
        "style": "short|paragraph?",
        "placeholder": "string?",
        "required": "boolean?"
      },
      "section": {
        "components": "Component[]",
        "accessory": "Component?"
      },
      "textDisplay": {
        "content": "string"
      },
      "thumbnail": {
        "media": "Media",
        "description": "string?",
        "isSpoiler": "boolean?"
      },
      "mediaGallery": {
        "items": "MediaGalleryItem[]"
      },
      "file": {
        "file": "Media",
        "isSpoiler": "boolean?"
