  "SelectOption": {
    "fields": {
      "label": "string",
      "value": "string",
      "description": "string?",
      "emoji": "string?",
      "isDefault": "boolean?"
    }
  },
  "Media": {
    "fields": {
      "url": "string"
    }
  },
  "MediaGalleryItem": {
    "fields": {
      "media": "Media",
      "description": "string?",
      "isSpoiler": "boolean?"
    }
  },
  "AllowedMentions": {
    "desc": "Mentions autorisées sur le message (ping control).",
    "fields": {
      "parse": "string[]?",
      "users": "string[]?",
      "roles": "string[]?"
    }
  },
  "WebhookEmbed": {
    "desc": "Embed webhook: seuls title, description, color, footer sont lus.",
    "fields": {
      "title": "string?",
      "description": "string?",
      "color": "string?",
      "footer": "EmbedFooter|string?"
    }
  },
  "ComponentsDefV2": {
    "desc": "Définition Component V2 : { components, ephemeral? }. ephemeral se place ICI (et non au niveau du payload) pour respondWithComponentV2/sendComponentV2.",
    "fields": {
      "components": "Component[]",
      "ephemeral": "boolean?"
    }
  },
  "ModalTextInput": {
    "desc": "Champ texte du format modal legacy (inputs[]).",
    "fields": {
      "customId": "string",
      "label": "string",
      "style": "short|paragraph?",
      "placeholder": "string?",
      "defaultValue": "string?",
      "required": "boolean?",
      "minLength": "number?",
      "maxLength": "number?"
    }
  },
  "ElseIfBranch": {
    "desc": "Branche else-if d'un ifBlock : une condition (feuille ou groupe). Le nœud a un pin `elseif:<i>` par entrée ; les actions de la branche sont les nœuds reliés à ce pin.",
    "fields": {
      "variable": "string?",
      "operator": "string?",
      "value": "string|number?",
      "group": "and|or?",
      "conditions": "Condition[]?",
      "negate": "boolean?",
      "graph": "Graph?"
    }
  },
  "RuntimeJsonOperation": {
    "desc": "Opération d'un runtimeJsonBlock.",
    "fields": {
      "op": "get|set|unset|clear|exists|stringify|pretty|initArray|arrayAppend|arrayUnshift|arrayPop|arrayShift|arraySort|arrayReverse|arrayCount|arrayIndex|joinArray|keys",
      "path": "string[]?",
      "value": "string?",
      "forceString": "boolean?",
      "separator": "string?",
      "order": "asc|desc?",
      "descending": "boolean?",
      "indent": "string|number?",
      "readIndex": "string|number?"
    }
  },
  "CanvasOperation": {
    "desc": "Opération d'image canvas (clé op + champs propres à l'opération : width, height, color, url, dataUrl, x, y, container...).",
    "fields": {
      "op": "create|loadImage|compositeImage|drawText|drawCircle|drawRect|drawLine|progressBar|setPixel|invert|grayscale|rotate|container",
      "container": "string?",
      "width": "string|number?",
      "height": "string|number?",
      "color": "string?",
      "url": "string?",
      "dataUrl": "string?",
      "x": "string|number?",
      "y": "string|number?"
    }
  }
}
