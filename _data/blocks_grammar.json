      "allowedMentions": "AllowedMentions?",
      "delay": "string?",
      "bdfdDelayedEdit": "boolean?"
    },
    "output": "((action.<key>)) (messageId)"
  },
  "deleteMessages": {
    "desc": "Supprime un message precis ou purge des messages recents d'un salon.",
    "category": "Messages",
    "params": {
      "channelId": "string?",
      "messageId": "string?",
      "messageCount": "number?",
      "count": "number?",
      "onlyUserId": "string?",
