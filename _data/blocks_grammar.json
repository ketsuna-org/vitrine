{
  "sendMessage": {
    "desc": "Envoie un message, embed ou composants dans un salon, en MP, en reponse, ou publie/typing selon targetType.",
    "category": "Messages",
    "params": {
      "channelId": "string?",
      "content": "string?",
      "targetType": "channel|user|reply|crosspost|typing?",
      "userId": "string?",
      "messageId": "string?",
      "embeds": "Embed[]?",
      "messageMode": "normal|componentV2?",
      "components": "ComponentsDef?",
      "componentV2": "ComponentsDef?",
      "allowedMentions": "AllowedMentions?",
      "deleteAfter": "string?",
      "deleteIn": "string?"
    },
    "output": "((action.<key>.messageId)) (aussi ((action.<key>)) et ((last.response.id)))"
  },
  "editMessage": {
    "desc": "Modifie le contenu, les embeds ou les composants d'un message existant.",
    "category": "Messages",
