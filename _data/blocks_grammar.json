  },
  "pinMessage": {
    "desc": "Epingle un message dans un salon textuel.",
    "category": "Messages",
    "params": {
      "channelId": "string?",
      "messageId": "string",
      "reason": "string?"
    },
    "output": "((action.<key>)) (messageId)"
  },
  "unpinMessage": {
    "desc": "Desepingle un message d'un salon.",
    "category": "Messages",
    "params": {
      "channelId": "string?",
      "messageId": "string",
      "reason": "string?"
    },
    "output": "((action.<key>)) = unpinned"
  },
  "getMessage": {
    "desc": "Recupere les metadonnees d'un message (auteur, contenu, horodatage).",
